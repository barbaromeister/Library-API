      "type": "text", "id": "c-dto-text", "x": 500, "y": 585, "width": 340, "height": 660,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 29, "version": 1, "versionNonce": 1029, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 14, "fontFamily": 3, "text": "Java 21 records\n@Valid + jakarta.validation\nMapping: DTO.from(Entity)\n\nauth/\n  · LoginRequest\n     username, password\n  · RegisterRequest\n     username @Size 3-30\n     email    @Email\n     password @Size 8-72\n  · AuthResponse\n     token, tokenType, user\n  · UserResponse\n     id, username, email,\n     role, createdAt\n\nbook/\n  · BookRequest\n     title, author, isbn,\n     publishDate, pageCount,\n     publisher, description,\n     language, covers\n  · BookResponse\n     + id, googleBooksId,\n     createdAt, updatedAt\n  · CoverImages (nested)\n     small, thumb, medium,\n     large\n\nsearch/\n  · GoogleBookResult\n     (eski BookSuggestion)\n  · SearchResponse\n     query, count, results\n  · AddToCollectionRequest\n     googleBooksId\n\ncommon/\n  · ErrorResponse\n     timestamp Instant\n     status, error,\n     message, path,\n     fieldErrors[]?",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "Java 21 records\n@Valid + jakarta.validation\nMapping: DTO.from(Entity)\n\nauth/\n  · LoginRequest\n     username, password\n  · RegisterRequest\n     username @Size 3-30\n     email    @Email\n     password @Size 8-72\n  · AuthResponse\n     token, tokenType, user\n  · UserResponse\n     id, username, email,\n     role, createdAt\n\nbook/\n  · BookRequest\n     title, author, isbn,\n     publishDate, pageCount,\n     publisher, description,\n     language, covers\n  · BookResponse\n     + id, googleBooksId,\n     createdAt, updatedAt\n  · CoverImages (nested)\n     small, thumb, medium,\n     large\n\nsearch/\n  · GoogleBookResult\n     (eski BookSuggestion)\n  · SearchResponse\n     query, count, results\n  · AddToCollectionRequest\n     googleBooksId\n\ncommon/\n  · ErrorResponse\n     timestamp Instant\n     status, error,\n     message, path,\n     fieldErrors[]?",
      "autoResize": true, "lineHeight": 1.3, "baseline": 12
    },

