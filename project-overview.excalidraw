    {
      "type": "text", "id": "c-ent-text", "x": 1700, "y": 585, "width": 340, "height": 660,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 38, "version": 1, "versionNonce": 1038, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 14, "fontFamily": 3, "text": "@Entity Book   tbl: books\n  · id              Long PK\n  · title           String NN\n  · author          String NN\n  · isbn            String(13)\n  · publishDate     LocalDate\n  · pageCount       Integer\n  · googleBooksId   String UQ\n  · publisher       String\n  · description     TEXT\n  · language        String\n  · smallThumbnail  String\n  · thumbnail       String\n  · mediumImage     String\n  · largeImage      String\n  · users           Set<User> M2M\n  · createdAt       LocalDateTime\n  · updatedAt       LocalDateTime\n  ⚠ users JSON'a sızıyor\n  → Faz 2C: BookResponse\n     ile temizlenir\n\n@Entity User   tbl: users\n  · id              Long PK\n  · username        String UQ NN\n  · email           String UQ NN\n  · password        String NN\n     BCrypt hash\n  · role            enum USER|ADMIN\n  · books           Set<Book> M2M\n  · createdAt       LocalDateTime\n  · updatedAt       LocalDateTime\n  ⚠ password JSON'a sızabilir\n  → Faz 2C: UserResponse\n\nJoin table: user_books\n  (user_id, book_id)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "@Entity Book   tbl: books\n  · id              Long PK\n  · title           String NN\n  · author          String NN\n  · isbn            String(13)\n  · publishDate     LocalDate\n  · pageCount       Integer\n  · googleBooksId   String UQ\n  · publisher       String\n  · description     TEXT\n  · language        String\n  · smallThumbnail  String\n  · thumbnail       String\n  · mediumImage     String\n  · largeImage      String\n  · users           Set<User> M2M\n  · createdAt       LocalDateTime\n  · updatedAt       LocalDateTime\n  ⚠ users JSON'a sızıyor\n  → Faz 2C: BookResponse\n     ile temizlenir\n\n@Entity User   tbl: users\n  · id              Long PK\n  · username        String UQ NN\n  · email           String UQ NN\n  · password        String NN\n     BCrypt hash\n  · role            enum USER|ADMIN\n  · books           Set<Book> M2M\n  · createdAt       LocalDateTime\n  · updatedAt       LocalDateTime\n  ⚠ password JSON'a sızabilir\n  → Faz 2C: UserResponse\n\nJoin table: user_books\n  (user_id, book_id)",
      "autoResize": true, "lineHeight": 1.3, "baseline": 12
    },

