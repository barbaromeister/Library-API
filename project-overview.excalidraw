    {
      "type": "text", "id": "b-text", "x": 1340, "y": 155, "width": 1180, "height": 260,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 21, "version": 1, "versionNonce": 1021, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 15, "fontFamily": 3, "text": "BACKEND\n  · Spring Boot 3.5.3                 · Java 21\n  · Spring Web (MVC)                  · Spring Data JPA / Hibernate\n  · Spring Security                   · Spring WebFlux WebClient (Google Books)\n  · Maven                             · spring-boot-starter-validation [PLANNED — Faz 2D]\n\nAUTH\n  · BCryptPasswordEncoder (mevcut)    · JWT (HS256) [PLANNED — Faz 3A]\n\nPERSISTENCE\n  · PostgreSQL 15-alpine              · ddl-auto=update (dev)\n\nEXTERNAL\n  · Google Books API v1 (REST)\n\nFRONTEND  [PLANNED — Faz 4]\n  · Flutter (mobile iOS+Android + web)\n  · Dio (HTTP)                        · Riverpod (state)\n  · go_router (routing)               · flutter_secure_storage (JWT)\n  · freezed + json_serializable (DTO codegen)\n\nINFRA\n  · Docker / docker-compose           · eclipse-temurin:21-jre-alpine (runtime)",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "BACKEND\n  · Spring Boot 3.5.3                 · Java 21\n  · Spring Web (MVC)                  · Spring Data JPA / Hibernate\n  · Spring Security                   · Spring WebFlux WebClient (Google Books)\n  · Maven                             · spring-boot-starter-validation [PLANNED — Faz 2D]\n\nAUTH\n  · BCryptPasswordEncoder (mevcut)    · JWT (HS256) [PLANNED — Faz 3A]\n\nPERSISTENCE\n  · PostgreSQL 15-alpine              · ddl-auto=update (dev)\n\nEXTERNAL\n  · Google Books API v1 (REST)\n\nFRONTEND  [PLANNED — Faz 4]\n  · Flutter (mobile iOS+Android + web)\n  · Dio (HTTP)                        · Riverpod (state)\n  · go_router (routing)               · flutter_secure_storage (JWT)\n  · freezed + json_serializable (DTO codegen)\n\nINFRA\n  · Docker / docker-compose           · eclipse-temurin:21-jre-alpine (runtime)",
      "autoResize": true, "lineHeight": 1.3, "baseline": 13
    },

