    {
      "type": "text", "id": "c-cfg-text", "x": 2100, "y": 585, "width": 420, "height": 660,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 41, "version": 1, "versionNonce": 1041, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 14, "fontFamily": 3, "text": "config/SecurityConfig\n  @EnableWebSecurity\n  · BCryptPasswordEncoder\n  ⚠ anyRequest().permitAll()\n  ⚠ formLogin/basic disabled\n  ⚠ session (max 1)\n  → Faz 1C:\n     STATELESS sessions\n     /api/auth/** public\n     /api/admin/** ROLE_ADMIN\n     mutations  authenticated\n     + JwtAuthenticationFilter\n\nconfig/WebConfig\n  @Configuration YORUMLU !\n  → Faz 2E: CORS aç\n     allowedOrigins:\n       http://localhost:* (dev)\n       https://<flutter-host>\n     allowedHeaders: *\n     Authorization expose\n\nexception/\n  GlobalExceptionHandler\n   @ControllerAdvice\n   · ResourceNotFoundException\n      → 404 ErrorDetails\n   · Exception (catch-all)\n      → 500 ErrorDetails\n   ⚠ Date kullanıyor\n   → Faz 2C: ErrorResponse\n      (Instant)\n   → Faz 2D: handler ekle\n      MethodArgumentNotValid\n      → 400 + fieldErrors[]\n\n   ResourceNotFoundException\n   ErrorDetails (silinecek)\n\nLibraryApiApplication\n  @SpringBootApplication\n  main()",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "config/SecurityConfig\n  @EnableWebSecurity\n  · BCryptPasswordEncoder\n  ⚠ anyRequest().permitAll()\n  ⚠ formLogin/basic disabled\n  ⚠ session (max 1)\n  → Faz 1C:\n     STATELESS sessions\n     /api/auth/** public\n     /api/admin/** ROLE_ADMIN\n     mutations  authenticated\n     + JwtAuthenticationFilter\n\nconfig/WebConfig\n  @Configuration YORUMLU !\n  → Faz 2E: CORS aç\n     allowedOrigins:\n       http://localhost:* (dev)\n       https://<flutter-host>\n     allowedHeaders: *\n     Authorization expose\n\nexception/\n  GlobalExceptionHandler\n   @ControllerAdvice\n   · ResourceNotFoundException\n      → 404 ErrorDetails\n   · Exception (catch-all)\n      → 500 ErrorDetails\n   ⚠ Date kullanıyor\n   → Faz 2C: ErrorResponse\n      (Instant)\n   → Faz 2D: handler ekle\n      MethodArgumentNotValid\n      → 400 + fieldErrors[]\n\n   ResourceNotFoundException\n   ErrorDetails (silinecek)\n\nLibraryApiApplication\n  @SpringBootApplication\n  main()",
      "autoResize": true, "lineHeight": 1.3, "baseline": 12
    },

