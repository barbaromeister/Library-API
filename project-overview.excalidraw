    {
      "type": "text", "id": "c-ctrl-text", "x": 100, "y": 585, "width": 340, "height": 660,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 26, "version": 1, "versionNonce": 1026, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 14, "fontFamily": 3, "text": "AuthController\n  @RequestMapping /api/auth\n  · register, login, logout, me\n  ⚠ session + manual SecCtx\n  → Faz 3A: JWT döner\n\nBookController\n  @RequestMapping /api/books\n  · CRUD + search/{author,title,isbn}\n  ⚠ Book entity in/out\n  → Faz 2C: BookRequest/Response\n  → Faz 2B: updateBook eksik alanlar\n\nBookSearchController\n  @RequestMapping /api/books\n  · /search, /suggest\n  · /add-to-collection\n  · /check-collection\n  · /test-search  ← silinecek\n  → Faz 2A: BookController'a birleşir\n\nAdminController\n  @RequestMapping /api/admin\n  · /test, /users\n  ⚠ mock veri + email sızıntısı\n  → Faz 1B: gerçek UserRepository\n\n────────────────────────\n× WebController        Faz 0 ✓\n× SetupController      Faz 1A ✓\n× TestController       Faz 1B ✓",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "AuthController\n  @RequestMapping /api/auth\n  · register, login, logout, me\n  ⚠ session + manual SecCtx\n  → Faz 3A: JWT döner\n\nBookController\n  @RequestMapping /api/books\n  · CRUD + search/{author,title,isbn}\n  ⚠ Book entity in/out\n  → Faz 2C: BookRequest/Response\n  → Faz 2B: updateBook eksik alanlar\n\nBookSearchController\n  @RequestMapping /api/books\n  · /search, /suggest\n  · /add-to-collection\n  · /check-collection\n  · /test-search  ← silinecek\n  → Faz 2A: BookController'a birleşir\n\nAdminController\n  @RequestMapping /api/admin\n  · /test, /users\n  ⚠ mock veri + email sızıntısı\n  → Faz 1B: gerçek UserRepository\n\n────────────────────────\n× WebController        Faz 0 ✓\n× SetupController      Faz 1A ✓\n× TestController       Faz 1B ✓",
      "autoResize": true, "lineHeight": 1.3, "baseline": 12
    },

