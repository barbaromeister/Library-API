    {
      "type": "text", "id": "c-repo-text", "x": 1300, "y": 585, "width": 340, "height": 660,
      "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "groupIds": [], "frameId": null, "roundness": null,
      "seed": 35, "version": 1, "versionNonce": 1035, "isDeleted": false,
      "boundElements": null, "updated": 1735000000000, "link": null, "locked": false,
      "fontSize": 14, "fontFamily": 3, "text": "Spring Data JPA\nextends JpaRepository<E, ID>\n\nBookRepository : <Book, Long>\n  · findAll()\n  · findById(id)\n  · save(book)\n  · delete(book)\n  ── custom queries ──\n  · findByAuthorContaining\n     IgnoreCase(author)\n  · findByTitleContaining\n     IgnoreCase(title)\n  · findByIsbn(isbn)\n  · findByGoogleBooksId(gid)\n  · findByTitleAndAuthor\n     (title, author)\n\nUserRepository : <User, Long>\n  · findById, save, delete\n  ── custom queries ──\n  · findByUsername(u)\n  · findByEmail(e)\n  · existsByUsername(u)\n  · existsByEmail(e)\n\nNote:\n  Hibernate ddl-auto=update\n  (dev only). Flyway/Liquibase\n  prod için ileride.",
      "textAlign": "left", "verticalAlign": "top", "containerId": null,
      "originalText": "Spring Data JPA\nextends JpaRepository<E, ID>\n\nBookRepository : <Book, Long>\n  · findAll()\n  · findById(id)\n  · save(book)\n  · delete(book)\n  ── custom queries ──\n  · findByAuthorContaining\n     IgnoreCase(author)\n  · findByTitleContaining\n     IgnoreCase(title)\n  · findByIsbn(isbn)\n  · findByGoogleBooksId(gid)\n  · findByTitleAndAuthor\n     (title, author)\n\nUserRepository : <User, Long>\n  · findById, save, delete\n  ── custom queries ──\n  · findByUsername(u)\n  · findByEmail(e)\n  · existsByUsername(u)\n  · existsByEmail(e)\n\nNote:\n  Hibernate ddl-auto=update\n  (dev only). Flyway/Liquibase\n  prod için ileride.",
      "autoResize": true, "lineHeight": 1.3, "baseline": 12
    },

